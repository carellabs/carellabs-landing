---
import type { Lang, Messages } from "../i18n/types";

interface Props {
  lang: Lang;
  t: Messages;
}
const { lang, t } = Astro.props;
const other = lang === "es" ? "en" : "es";
// Año de la primera publicación, fijo a propósito: el mismo commit tiene que generar siempre el
// mismo HTML (build reproducible; prod-check lo compara byte a byte con producción). Un aviso de
// copyright lleva el año de publicación, no el de construcción.
const year = 2026;
---

<footer class="foot">
  <p>
    <span>© {year} {t.footer.rights}</span>
    <span>{t.footer.source}</span>
  </p>
  <a
    href={t.site.switchHref}
    lang={other}
    hreflang={other}
    aria-label={t.site.switchToName}>{t.site.switchTo}</a
  >
</footer>
