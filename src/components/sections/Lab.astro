---
import apps from "../../data/apps.json";
import type { Lang, Messages } from "../../i18n/types";
import { hostLine } from "../../lib/host";

interface Props {
  lang: Lang;
  t: Messages;
}
const { lang, t } = Astro.props;

type Status = keyof Messages["lab"]["status"];

// Una app con `"hidden": true` sigue en apps.json, pero no se muestra (para ocultarla de momento sin borrarla).
const visibleApps = apps.filter((app) => !("hidden" in app && app.hidden === true));
---

<section class="section" id="lab" aria-labelledby="h-lab">
  <h2 id="h-lab">{t.lab.title}</h2>
  <p class="section-intro">{t.lab.intro}</p>
  <ul class="apps" role="list">
    {
      visibleApps.map((app) => {
        // Solo las apps en beta o disponibles enlazan y enseñan su dirección; el resto se muestra sin enlace
        // y sin dirección (aún no existe), y puede no tener `url`.
        const href = app.status === "live" || app.status === "beta" ? app.url : undefined;
        return (
          <li class="app">
            <div class="app-head">
              <div>
                <h3 class="name">
                  {href ? <a href={href} rel="noopener">{app.name}</a> : app.name}
                </h3>
                {href && <p class="host">{hostLine(href)}</p>}
              </div>
              <span class="status" data-status={app.status}>
                {t.lab.status[app.status as Status]}
              </span>
            </div>
            <p class="desc">{app.description[lang]}</p>
            <ul class="tokens" role="list" aria-label={t.lab.stackLabel}>
              {app.stack.map((s) => <li>{s}</li>)}
            </ul>
          </li>
        );
      })
    }
  </ul>
</section>
