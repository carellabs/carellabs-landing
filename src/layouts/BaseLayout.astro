---
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
// Precarga solo la cara latina: cubre ES y EN, y el titular (LCP) la usa.
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  lang: "es" | "en";
  title: string;
  description: string;
  /** Página que no debe indexarse (la 404): `robots: noindex` y sin canonical, hreflang ni og:*. */
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://carellabs.com");
const canonical = new URL(Astro.url.pathname, site);
const esUrl = new URL("/", site);
const enUrl = new URL("/en/", site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es" href={esUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={esUrl} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    {
      !noindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          {/* Una imagen por idioma con su titular; se regeneran con `npm run og`. */}
          <meta property="og:image" content={new URL(`/og-${lang}.png`, site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={description} />
          <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_GB"} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
