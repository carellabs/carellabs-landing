{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carellabs-landing",
  "compatibility_date": "2026-10-10",
  // Solo assets estáticos (dist/ de `astro build`), sin código Worker (`main`):
  // así Cloudflare aplica public/_headers (CSP, caché) a todas las respuestas.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Producción en el dominio propio (Custom Domain: Cloudflare crea el registro DNS).
  // La URL *.workers.dev de producción queda desactivada; las vistas previas de las
  // ramas siguen en workers.dev porque preview_urls se declara aparte.
  "routes": [{ "pattern": "carellabs.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  // Sin telemetría de wrangler, coherente con «sin rastreadores».
  "send_metrics": false
}
